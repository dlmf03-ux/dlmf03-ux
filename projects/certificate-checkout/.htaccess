# ─── Безопасность платёжного сервиса ─────────────────────────

# Запрет листинга директории
Options -Indexes

# Запрет прямого доступа к служебным файлам
<FilesMatch "(config\.php|install\.sql|.*\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Запрет доступа к папкам lib/ и logs/ напрямую
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Блокируем прямой доступ к /lib/
    RewriteRule ^lib/ - [F,L]

    # Блокируем прямой доступ к /logs/
    RewriteRule ^logs/ - [F,L]
</IfModule>

# PHP настройки безопасности
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Кодировка
AddDefaultCharset UTF-8
