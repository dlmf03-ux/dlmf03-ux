BOT_TOKEN=replace_with_telegram_bot_token
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=demo_orders
DB_USER=demo_user
DB_PASS=replace_me

ADMIN_EMAILS=admin@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=bot@example.com
SMTP_PASS=replace_me
SMTP_FROM_EMAIL=bot@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Optional proxy: http://user:password@host:port
TELEGRAM_PROXY=
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_random_secret
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8080
LOG_LEVEL=INFO
